# Copy to .env and replace DB_PASSWORD with your own strong local password before first start.
# The public template fallback remains available only for compatibility.
# Do not commit .env or reuse personal/corporate credentials.
# Avoid connection-string delimiters (semicolon/quotes) in this local password.
DB_PASSWORD=Choose_A_Local_Password_2026!
DB_PORT=1433
DB_NAME=PropertyMaintenanceDb_Demo
TEST_DATABASE_NAME=PropertyMaintenanceDb_T04_Integration
APP_PORT=8080
API_PORT=8081
# Development enables the demo OpenAPI/Swagger endpoints.
# For production, explicitly set Production and SEED_DEMO_DATA=false.
ASPNETCORE_ENVIRONMENT=Development
SEED_DEMO_DATA=true
# Optional for parallel copies: choose a unique project name and unused ports.
# Without this override, Compose retains the existing prueba-tecnica-dotnet name.
# COMPOSE_PROJECT_NAME=propertymaintenance-local-copy
# Example parallel-copy ports: DB_PORT=15433, APP_PORT=18080, API_PORT=18081.
