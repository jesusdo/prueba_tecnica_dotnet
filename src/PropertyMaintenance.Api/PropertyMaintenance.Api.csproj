<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="7.2.0" />
    <!-- Security override for SqlClient's transitive PKCS dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DbUp" Version="5.0.40" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical developer-authored SQL: embed unchanged, without duplicate files. -->
    <EmbeddedResource Include="..\..\database\scripts\dbo.usp_GetPropertiesSummary.sql">
      <LogicalName>PropertyMaintenance.Api.database.migrations.006_CreatePropertiesSummaryProcedure.sql</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\database\scripts\dbo.usp_GetTechniciansWorkload.sql">
      <LogicalName>PropertyMaintenance.Api.database.migrations.007_CreateTechniciansWorkloadProcedure.sql</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\database\migrations\*.sql">
      <LogicalName>PropertyMaintenance.Api.database.migrations.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\database\seed\*.sql">
      <LogicalName>PropertyMaintenance.Api.database.seed.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
